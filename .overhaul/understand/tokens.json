    "measuredEffect": {
      "noise.png@0.05 on #0D0D0D": "mean 13.72/255, range 13.00–16.27",
      "noise-dark.png@0.06 on #0D0D0D": "mean 13.13, range 12.99–13.85",
      "noise-dark.png@0.09 on #111111": "mean 17.18, range 16.98–18.20",
      "noise.png@0.05 on #121212": "mean 18.70, range 18.00–21.21"
