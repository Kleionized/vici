# Tideline environment — copy to `.env.local` and fill in.
#
# IMPORTANT: With BOTH values blank, the app runs fully in OFFLINE MOCK mode
# (local auth + local data). Fill these in to switch to real Convex + Clerk.
# See SETUP.md for the exact steps to obtain each value.

# Convex deployment URL. Created by running `npx convex dev` (writes it for you).
# Presence of this var flips the data layer from mock to Convex.
EXPO_PUBLIC_CONVEX_URL=

# Clerk publishable key (pk_test_... or pk_live_...), from the Clerk dashboard.
# Presence of this var flips auth from mock to Clerk.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# RevenueCat public SDK keys, from app.revenuecat.com → Project → API keys.
# These are client keys and are safe to ship in the bundle.
#
# Development: one Test Store key (`test_...`) covers iOS, Android, Expo Go and
# web, and simulates purchases with no App Store / Play setup at all.
EXPO_PUBLIC_REVENUECAT_KEY=
# Production: the per-store keys. Each takes precedence over the shared key on
# its own platform. NEVER ship a `test_...` key to a store.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Web Billing key (`rcb_...`), if the web build should sell as well as preview.
EXPO_PUBLIC_REVENUECAT_WEB_KEY=

# Which paywall `/paywall` opens:
#   offering   (default) VICI's own paywall, drawn from the offering
#   revenuecat           the paywall designed in the RevenueCat dashboard
#   designed             the drawn VICI paywall — two rows, canvas prices
# EXPO_PUBLIC_REVENUECAT_PAYWALL=offering
# Pin purchases to the offline catalogue while leaving the rest of the app real.
# EXPO_PUBLIC_FORCE_MOCK_PURCHASES=1
