# Tideline environment — copy to `.env.local` and fill in.
#
# IMPORTANT: With BOTH values blank, the app runs fully in OFFLINE MOCK mode
# (local auth + local data). Fill these in to switch to real Convex + Clerk.
# See SETUP.md for the exact steps to obtain each value.

# Convex deployment URL. Created by running `npx convex dev` (writes it for you).
# Presence of this var flips the data layer from mock to Convex.
EXPO_PUBLIC_CONVEX_URL=

# Clerk publishable key (pk_test_... or pk_live_...), from the Clerk dashboard.
# Presence of this var flips auth from mock to Clerk.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
